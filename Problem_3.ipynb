# Problem 3: Checking Routes Between Cities Using DFS

# Graph representing cities in West Bengal and their road connections
graph = {
    "Kolkata": ["Durgapur", "Asansol"],
    "Durgapur": ["Kolkata", "Asansol", "Siliguri"],
    "Asansol": ["Kolkata", "Durgapur"],
    "Siliguri": ["Durgapur"],
    "Malda": ["Murshidabad"],
    "Murshidabad": ["Malda"]
}


# Function to check whether a route exists between two cities
def route_exists(graph, start, destination):
    visited = set()

    def dfs(city):
        if city == destination:
            return True

        visited.add(city)

        for neighbor in graph[city]:
            if neighbor not in visited:
                if dfs(neighbor):
                    return True

        return False

    return dfs(start)


# Function to find one connected component using DFS
def find_component(graph, start, visited):
    component = []

    def dfs(city):
        visited.add(city)
        component.append(city)

        for neighbor in graph[city]:
            if neighbor not in visited:
                dfs(neighbor)

    dfs(start)
    return component


# Check whether a route exists
start_city = "Kolkata"
destination_city = "Siliguri"

if route_exists(graph, start_city, destination_city):
    print(f"Route exists from {start_city} to {destination_city}")
else:
    print(f"No route exists from {start_city} to {destination_city}")


# Find all connected components
visited = set()
components = []

for city in graph:
    if city not in visited:
        component = find_component(graph, city, visited)
        components.append(component)


# Display connected components
print("\nConnected Components:")

for i, component in enumerate(components, 1):
    print(f"Component {i}: {component}")
